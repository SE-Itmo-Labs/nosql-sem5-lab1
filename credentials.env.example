POSTGRES_USER=username_here
POSTGRES_PASSWORD=password_here
POSTGRES_DB=database_name_here
POSTGRES_PORT=5432
POSTGRES_VOLUME_NAME=nosql-sem5-lab1_postgres_data
# Включайте только для локального заполнения демонстрационными данными.
APP_DATA_INITIALIZER_ENABLED=false

# По умолчанию Hibernate будет перезаписывать все данные в бд (create), update - создать поверх имеющихся данных автоматом, validate - четотам в ручном режиме
# Если есть эта переменная, то значит это не debug mode:
# DDL_AUTO=update